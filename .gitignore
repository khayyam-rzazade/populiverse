# R and RStudio working files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto working files, and the built site (GitHub builds the site itself)
/.quarto/
/_site/
**/*.quarto_ipynb

# Drafts stay on this computer until publication day
/drafts/

# macOS folder settings
.DS_Store

# Private settings such as the Zotero key never belong in this folder
# (the key lives in the home folder, in ~/.Renviron)
.Renviron

# An issue or a piece in preparation: while the name of its folder ends in
# "-draft", it stays on this computer and GitHub never sees it.
# scripts/make_issue.R takes the ending away on publication day.
/monitor/*-draft/
/commentary/*-draft/
