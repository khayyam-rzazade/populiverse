# R and RStudio working files
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Quarto working files, and the built site (GitHub builds the site itself)
/.quarto/
/_site/
**/*.quarto_ipynb

# Drafts stay on this computer until publication day
/drafts/

# The actor and country pages: scripts/make_pages.py writes them at every build,
# with the Monitor's part of the data pages and the events dataset
/actors/
/countries/
/data/monitor.json
/data/events.csv

# macOS folder settings
.DS_Store

# Private settings such as the Zotero key never belong in this folder
# (the key lives in the home folder, in ~/.Renviron)
.Renviron

# An issue or a piece in preparation: while the name of its folder ends in
# "-draft", it stays on this computer and GitHub never sees it.
# scripts/make_issue.R takes the ending away on publication day.
/monitor/*-draft/
/commentary/*-draft/

# The Workspace's server: the tools it installs and the local copies its tests
# make. GitHub installs the tools itself, from server/package-lock.json.
/server/node_modules/
/server/.wrangler/

# The settings a local server needs to run on this computer. They are secrets,
# and the real ones live at Cloudflare, so this file must never be committed.
# Note that the tests read it too, and the tests fail while it is there, so it
# is moved aside before running them.
/server/.dev.vars
