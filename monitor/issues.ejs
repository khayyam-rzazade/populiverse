```{=html}
<%
// The list of issues on the Monitor page: for every issue a small cover
// (the first page of its PDF, drawn by the site) and the facts next to it.
// Number and month come from the issue's own header ("issue", "subtitle").
// In this kind of template the tag with a hyphen writes plain text safely,
// and the tag with an equals sign writes a piece of HTML as it is.
const esc = (s) => String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const plain = (s) => String(s == null ? "" : s).replace(/<[^>]*>/g, "");
const wordmark = (s) => esc(s).replace("PopuliVerse", "Populi<em>Verse</em>");
%>
<% if (items.length > 0) { %>
<div class="pv-issue-list">
<% for (const item of items) { %>
<%
  const title = plain(item.title);
  const found = title.match(/\d{4}\/\d+/);
  const number = plain(item.issue) || (found ? found[0] : "");
  const month = plain(item.subtitle);
%>
<a class="pv-issue-card quarto-post" href="<%- item.path %>">
<span class="pv-cover pv-cover-monitor pv-cover-icon" aria-hidden="true"><span class="pv-cover-frame">
<span class="pv-cover-series">Populi<em>Verse</em></span>
<span class="pv-cover-title">Monitor</span>
<span class="pv-cover-number"><%- number %></span>
<span class="pv-cover-date"><%- month %></span>
</span></span>
<span class="pv-issue-card-text">
<span class="pv-issue-card-title"><%= wordmark(title) %></span>
<span class="pv-issue-card-month"><%- month %></span>
<span class="pv-issue-card-desc"><%- plain(item.description) %></span>
<span class="pv-issue-card-more">Read the issue</span>
</span>
</a>
<% } %>
</div>
<% } %>
```
